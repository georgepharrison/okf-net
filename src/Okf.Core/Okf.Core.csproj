<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Okf.Core is the internal library layer behind the executable, not a distributed NuGet API. -->
    <IsPackable>false</IsPackable>
    <!-- decisions.md §3 / PRD CLI-17: NativeAOT single-file is the preferred
         publish mode, so the core library is analyzed for AOT and trim safety. -->
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The static site's stylesheet and client script ship inside the binary
         (issue #6). `GetManifestResourceStream` reads them at run time, which is
         NativeAOT-safe: a manifest resource is data in the image, not a type the
         trimmer has to be told to keep. The logical names are pinned so they do not
         move if the folder is ever renamed (#59 moved Assets/ under Site/, and the
         pinned LogicalName is why nothing downstream had to change); `OkfSiteAssets`
         names them back. -->
    <EmbeddedResource Include="Site\Assets\site.css" LogicalName="Okf.Core.Assets.site.css" />
    <EmbeddedResource Include="Site\Assets\site.js" LogicalName="Okf.Core.Assets.site.js" />
  </ItemGroup>

  <ItemGroup>
    <!-- The three agent skills ship inside the binary (issue #41), by the same
         mechanism and for the same AOT reason as the site assets above: a consumer
         who installed only the binary has no `skills/` directory to point a recipe
         at, and a second download would put the skills behind a network the rest of
         the toolset does not need (AD-7).

         A GLOB, not three lines: a skill added to skills/ is embedded by the next
         build, and OkfSkillsTests asserts the embedded set equals the on-disk set, so
         the two cannot drift. Only SKILL.md is taken — skills/README.md is repository
         documentation about the skills, not part of any one of them. -->
    <EmbeddedResource Include="..\..\skills\*\SKILL.md">
      <LogicalName>Okf.Core.Skills.$([System.IO.Path]::GetFileName($([System.IO.Path]::GetDirectoryName('%(FullPath)')))).SKILL.md</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- The lint helpers (markdown scanning, link resolution, frontmatter line
         bookkeeping) are internal: implementation detail of the rules, not public API.
         Their edge cases are still worth direct unit tests. -->
    <InternalsVisibleTo Include="Okf.Core.Tests" />
  </ItemGroup>

</Project>
