<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- decisions.md §3 / PRD CLI-17: NativeAOT single-file is the preferred
         publish mode, so the core library is analyzed for AOT and trim safety. -->
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The static site's stylesheet and client script ship inside the binary
         (issue #6). `GetManifestResourceStream` reads them at run time, which is
         NativeAOT-safe: a manifest resource is data in the image, not a type the
         trimmer has to be told to keep. The logical names are pinned so they do not
         move if the folder is ever renamed; `OkfSiteAssets` names them back. -->
    <EmbeddedResource Include="Assets\site.css" LogicalName="Okf.Core.Assets.site.css" />
    <EmbeddedResource Include="Assets\site.js" LogicalName="Okf.Core.Assets.site.js" />
  </ItemGroup>

  <ItemGroup>
    <!-- The lint helpers (markdown scanning, link resolution, frontmatter line
         bookkeeping) are internal: implementation detail of the rules, not public API.
         Their edge cases are still worth direct unit tests. -->
    <InternalsVisibleTo Include="Okf.Core.Tests" />
  </ItemGroup>

</Project>
