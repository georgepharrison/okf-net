#!/usr/bin/env bash
# Enforce Conventional Commits v1.0.0 (https://www.conventionalcommits.org/en/v1.0.0/)
# on the first line of the commit message.
#
# Delegates to scripts/check-commit-msg.sh, which is also used by the
# `check-commit` mise task, so the hook and the task share one source of
# truth for the validation rules.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
exec "$repo_root/scripts/check-commit-msg.sh" "$1"
